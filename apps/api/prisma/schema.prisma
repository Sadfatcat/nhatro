generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         String
  isActive     Boolean   @default(true)
  roomId       String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  landlord     Landlord?
  room         Room?     @relation(fields: [roomId], references: [id])
}

model Room {
  id            String         @id @default(cuid())
  roomNumber    String         @unique
  floor         Int
  price         Int
  status        String         @default("AVAILABLE")
  description   String?
  branchId      String?
  landlordId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  billingDay    Int            @default(15)
  contracts     Contract[]
  invoices      Invoice[]
  landlord      Landlord?      @relation(fields: [landlordId], references: [id])
  account       User?
  utilityRecords UtilityRecord[]
}

model UtilityRecord {
  id           String   @id @default(cuid())
  roomId       String
  prevElec     Float    @default(0)
  currElec     Float    @default(0)
  prevWater    Float    @default(0)
  currWater    Float    @default(0)
  recordedAt   DateTime @default(now())
  billingMonth String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  room         Room     @relation(fields: [roomId], references: [id])

  @@unique([roomId, billingMonth])
  @@index([billingMonth])
}

model Tenant {
  id                   String     @id @default(cuid())
  fullName             String
  phone                String?
  email                String?
  dateOfBirth          DateTime?
  hometown             String?
  nationalId           String?
  tenantIdDate         String?
  nationalIdIssuePlace String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  contracts            Contract[]
}

model Contract {
  id               String    @id @default(cuid())
  roomId           String
  tenantId         String
  startDate        DateTime
  endDate          DateTime?
  firstBillingDate Int?
  lastBillingDate  Int?
  deposit          Int       @default(0)
  status           String    @default("ACTIVE")
  notes            String?
  filePath         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  room             Room      @relation(fields: [roomId], references: [id])
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  invoices         Invoice[]
}

model Landlord {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  rooms     Room[]
}

model Invoice {
  id                String        @id @default(cuid())
  roomId            String
  contractId        String
  period            String
  rentAmount        Int
  electricityAmount Int
  waterAmount       Int
  otherFees         Int           @default(0)
  totalAmount       Int
  prevElec          Float         @default(0)
  currElec          Float         @default(0)
  prevWater         Float         @default(0)
  currWater         Float         @default(0)
  elecUnitPrice     Int           @default(0)
  waterUnitPrice    Int           @default(0)
  referenceCode     String        @unique
  dueDate           DateTime
  status            InvoiceStatus @default(SENT)
  paidAt            DateTime?
  markedBy          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  room     Room     @relation(fields: [roomId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id])

  @@index([status])
  @@index([period])
}

enum InvoiceStatus {
  SENT
  PAID
  OVERDUE
}
